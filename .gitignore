node_modules/
target/
dist/
.DS_Store
*.log
# SQLite sidecars, anywhere. Merely READING a .sqlite (sqlite3, the viewer's
# demo file, a monitor run) creates these next to it; the database itself is
# tracked, the sidecars never are.
*.sqlite-wal
*.sqlite-shm
.env
.env.local

# Editor / migration backups. Bulk path-rewrites across the workspace leave
# *.bak-premove* next to every touched file; they are byte-identical copies and
# must never enter the repo.
*.bak
*.bak-*
